#!/usr/bin/env python3
"""Compile provider-neutral sandbox templates into provider lifecycle calls.

A template (agent-run/templates/*.yaml) describes what an environment needs:
resources, repositories, allowed runtimes, env, setup steps, and readiness
checks. A provider adapter compiles it into concrete calls.

`validate` and `compile` never touch a provider. `dispatch`, `status`, and
`rm` do: dispatch creates a VM from a compiled template and waits for its
readiness marker, status reports on dispatched runs, and rm deletes a run's
VM after confirmation. Run records are machine-local state under
`~/.local/state/agent-run` (override with AGENT_RUN_STATE_PATH).
"""

import argparse
import datetime
import json
import os
import pathlib
import shlex
import subprocess
import sys
import time

import jsonschema
import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
SCHEMA_PATH = ROOT / "templates" / "schema.json"

# Subscription-only pilot: provider API keys must never reach a sandbox.
FORBIDDEN_ENV = {"OPENAI_API_KEY", "ANTHROPIC_API_KEY"}

# exe.dev rejects setup scripts larger than 10KiB.
SETUP_SCRIPT_LIMIT = 10 * 1024

WORKDIR = '"$HOME"/work'
READY_MARKER = f"{WORKDIR}/.agent-run-ready"
READY_MARKER_REMOTE = "~/work/.agent-run-ready"

RUNTIME_PACKAGES = {"codex": "codex", "claude": "claude"}

SSH_BATCH_OPTS = ["-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new"]

AUTH_HINTS = {
    "codex": [
        "codex login --device-auth   # finish on your phone",
        "codex login status          # must report ChatGPT sign-in, not an API key",
        "happy codex                 # scan the QR with the Happy app",
    ],
    "claude": [
        "claude                      # choose the subscription login, complete the SSH flow",
        "/status                     # inside claude: confirm Pro/Max subscription",
        "happy claude                # scan the QR with the Happy app",
    ],
}


class TemplateError(Exception):
    pass


class RunError(Exception):
    pass


def sh(args, *, input_text=None, check=True):
    """Single subprocess seam so tests can fake provider calls."""
    result = subprocess.run(args, input=input_text, text=True, capture_output=True)
    if check and result.returncode != 0:
        # exe.dev reports errors on stdout (as JSON), so include both streams.
        detail = "\n".join(s.strip() for s in (result.stdout, result.stderr) if s.strip())
        raise RunError(f"command failed ({result.returncode}): {' '.join(args)}\n{detail}")
    return result


def load_template(path):
    with open(path) as f:
        template = yaml.safe_load(f)
    with open(SCHEMA_PATH) as f:
        schema = json.load(f)
    try:
        jsonschema.validate(template, schema)
    except jsonschema.ValidationError as e:
        raise TemplateError(f"{path}: {e.message} (at {'/'.join(map(str, e.absolute_path)) or '<root>'})")
    forbidden = FORBIDDEN_ENV & set(template.get("env", {}))
    if forbidden:
        raise TemplateError(
            f"{path}: env must not set provider API keys: {', '.join(sorted(forbidden))}"
        )
    return template


def repo_parts(repo_id):
    host, owner, name = repo_id.split("/")
    return host, owner, name


def clone_url(repo, exe_cfg):
    host, owner, name = repo_parts(repo["id"])
    integrations = exe_cfg.get("integrations", [])
    if host == "github.com" and any("github" in i for i in integrations):
        return f"https://github.int.exe.xyz/{owner}/{name}.git"
    return f"https://{host}/{owner}/{name}.git"


def render_setup_script(template, runtime, exe_cfg):
    lines = [
        "#!/usr/bin/env bash",
        f"# generated by agent-run from template '{template['name']}' (runtime: {runtime})",
        "set -euxo pipefail",
        f"WORK={WORKDIR}",
        'mkdir -p "$WORK"',
        "",
    ]

    for repo in template["repos"]:
        _, _, name = repo_parts(repo["id"])
        path = repo.get("path", name)
        branch = f" --branch {shlex.quote(repo['ref'])}" if repo.get("ref") else ""
        lines.append(f'git clone{branch} {clone_url(repo, exe_cfg)} "$WORK"/{shlex.quote(path)}')
    lines.append("")

    for step in template.get("setup", []):
        if step == "update-runtimes":
            lines.append(f"sudo exeuntu update {RUNTIME_PACKAGES[runtime]}")
        elif step == "install-happy":
            lines.append("sudo npm install -g happy")
        else:
            if step.get("cwd"):
                lines.append(f'( cd "$WORK"/{shlex.quote(step["cwd"])} && {step["run"]} )')
            else:
                lines.append(step["run"])
    lines.append("")

    for check in template.get("checks", []):
        lines.append(check)

    lines += ["", f"date -u +%FT%TZ > {READY_MARKER}", ""]
    return "\n".join(lines)


def compile_exe_dev(template, runtime, name):
    """Return (argv, setup_script) for the VM creation call. Executes nothing."""
    if runtime not in template["runtimes"]:
        raise TemplateError(
            f"runtime '{runtime}' is not allowed by template '{template['name']}' "
            f"(allowed: {', '.join(template['runtimes'])})"
        )
    exe_cfg = template.get("providers", {}).get("exe.dev", {})

    script = render_setup_script(template, runtime, exe_cfg)
    size = len(script.encode())
    if size > SETUP_SCRIPT_LIMIT:
        raise TemplateError(
            f"setup script is {size} bytes; exe.dev limits --setup-script to {SETUP_SCRIPT_LIMIT}"
        )

    args = ["ssh", "exe.dev", "new", "--json", f"--name={name}"]
    resources = template.get("resources", {})
    if "cpu" in resources:
        args.append(f"--cpu={resources['cpu']}")
    if "memory" in resources:
        args.append(f"--memory={resources['memory']}")
    if "disk" in resources:
        args.append(f"--disk={resources['disk']}")
    if exe_cfg.get("image"):
        args.append(f"--image={exe_cfg['image']}")
    for key, value in template.get("env", {}).items():
        args.append(f"--env={key}={value}")
    for integration in exe_cfg.get("integrations", []):
        args.append(f"--integration={integration}")
    # Template tags are explicit user intent; run metadata rides in the comment
    # instead of a tag because tag-scoped SSH keys reject unknown --tag values.
    for tag in exe_cfg.get("tags", []):
        args.append(f"--tag={tag}")
    args.append(f"--comment=agent-run:{template['name']}:{runtime}")
    args.append("--setup-script=/dev/stdin")

    # ssh joins remote arguments with spaces and exe.dev's parser splits on
    # them with no quoting, so no argument may contain whitespace.
    for arg in args[2:]:
        if len(arg.split()) > 1:
            raise TemplateError(f"argument would be split by the provider's parser: {arg!r}")
    return args, script


ADAPTERS = {"exe.dev": compile_exe_dev}


def display_command(args, script_path):
    return " ".join(shlex.quote(a) for a in args) + f" < {shlex.quote(str(script_path))}"


# --- run records ------------------------------------------------------------


def state_root():
    override = os.environ.get("AGENT_RUN_STATE_PATH")
    root = pathlib.Path(override) if override else pathlib.Path.home() / ".local/state/agent-run"
    return root


def run_record_path(name):
    return state_root() / "runs" / f"{name}.json"


def save_run(record):
    path = run_record_path(record["name"])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(record, indent=2) + "\n")


def load_run(name):
    path = run_record_path(name)
    if not path.exists():
        raise RunError(f"no run named '{name}' (see 'agent-run status')")
    return json.loads(path.read_text())


def list_runs():
    runs_dir = state_root() / "runs"
    if not runs_dir.is_dir():
        return []
    records = [json.loads(p.read_text()) for p in sorted(runs_dir.glob("*.json"))]
    return sorted(records, key=lambda r: r.get("created_at", ""), reverse=True)


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- provider operations ----------------------------------------------------


def create_vm(argv, script):
    result = sh(argv, input_text=script)
    try:
        info = json.loads(result.stdout)
    except json.JSONDecodeError:
        raise RunError(f"could not parse VM creation output as JSON:\n{result.stdout.strip()}")
    if info.get("error"):
        raise RunError(f"VM creation failed: {info['error']}")
    ssh_dest = info.get("ssh_dest")
    if not ssh_dest:
        raise RunError(f"VM creation output has no ssh_dest:\n{result.stdout.strip()}")
    return info


def wait_ready(ssh_dest, timeout, interval):
    deadline = time.monotonic() + timeout
    while True:
        result = sh(
            ["ssh", *SSH_BATCH_OPTS, ssh_dest, f"cat {READY_MARKER_REMOTE}"], check=False
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
        if time.monotonic() >= deadline:
            raise RunError(
                f"VM did not become ready within {timeout}s; check first-boot progress with: "
                f"ssh {ssh_dest}"
            )
        time.sleep(interval)


def push_prompt(ssh_dest, prompt_path):
    content = pathlib.Path(prompt_path).read_text()
    sh(
        ["ssh", *SSH_BATCH_OPTS, ssh_dest, "cat > ~/work/TASK.md"],
        input_text=content,
    )


def provider_vm_names():
    """Names of VMs currently listed by exe.dev, or None if the listing is unusable."""
    result = sh(["ssh", "exe.dev", "ls", "--json"], check=False)
    if result.returncode != 0:
        return None
    try:
        listing = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    if isinstance(listing, dict):
        listing = listing.get("vms", [])
    if not isinstance(listing, list):
        return None
    names = {vm.get("vm_name") or vm.get("name") for vm in listing if isinstance(vm, dict)}
    return names - {None}


# --- commands ---------------------------------------------------------------


def cmd_validate(args):
    load_template(args.template)
    print(f"{args.template}: valid")


def cmd_compile(args):
    template = load_template(args.template)
    adapter = ADAPTERS[args.provider]
    name = args.name or f"{template['name']}-{args.runtime}"
    argv, script = adapter(template, args.runtime, name)
    script_path = pathlib.Path(args.script_out or f"{name}-setup.sh")
    script_path.write_text(script)
    print(f"setup script -> {script_path} ({len(script.encode())} bytes)", file=sys.stderr)
    print(display_command(argv, script_path))


def cmd_dispatch(args):
    template = load_template(args.template)
    adapter = ADAPTERS[args.provider]
    name = args.name or f"{template['name']}-{args.runtime}"

    record_path = run_record_path(name)
    if record_path.exists() and json.loads(record_path.read_text()).get("status") != "deleted":
        raise RunError(f"run '{name}' already exists; 'agent-run rm {name}' first or pick another --name")

    argv, script = adapter(template, args.runtime, name)
    print(f"creating VM: {' '.join(shlex.quote(a) for a in argv)}", file=sys.stderr)
    info = create_vm(argv, script)
    record = {
        "name": name,
        "vm": info.get("vm_name") or info.get("name") or name,
        "ssh_dest": info["ssh_dest"],
        "provider": args.provider,
        "template": str(pathlib.Path(args.template).resolve()),
        "runtime": args.runtime,
        "status": "provisioning",
        "created_at": utc_now(),
    }
    save_run(record)
    print(f"created VM '{record['vm']}' ({record['ssh_dest']})", file=sys.stderr)

    if args.no_wait:
        print(f"{name}: provisioning (skipped wait; check with 'agent-run status')")
        return

    ready_at = wait_ready(record["ssh_dest"], args.wait_timeout, args.poll_interval)
    record["status"] = "ready"
    record["ready_at"] = ready_at
    save_run(record)

    if args.prompt_file:
        push_prompt(record["ssh_dest"], args.prompt_file)
        record["prompt_file"] = str(pathlib.Path(args.prompt_file).resolve())
        save_run(record)
        print(f"prompt copied to ~/work/TASK.md", file=sys.stderr)

    print(f"{name}: ready ({record['ssh_dest']})")
    print("\nnext, the human-only part:")
    print(f"  ssh {record['ssh_dest']}")
    for hint in AUTH_HINTS[args.runtime]:
        print(f"  {hint}")


def cmd_status(args):
    records = list_runs()
    if not records:
        print("no runs; create one with 'agent-run dispatch'")
        return
    live = None if args.offline else provider_vm_names()
    if live is None and not args.offline:
        print("(could not read provider VM listing; showing local state only)", file=sys.stderr)
    for record in records:
        status = record["status"]
        if live is not None and status != "deleted" and record["vm"] not in live:
            status = "missing"
        line = (
            f"{record['name']:24} {status:12} {record['runtime']:6} "
            f"{record.get('ssh_dest', '-'):28} {record['created_at']}"
        )
        print(line.rstrip())


def cmd_rm(args):
    record = load_run(args.name)
    if record["status"] == "deleted":
        print(f"{args.name}: already deleted")
        return
    live = provider_vm_names()
    if live is not None and record["vm"] not in live:
        record["status"] = "deleted"
        record["deleted_at"] = utc_now()
        save_run(record)
        print(f"{args.name}: VM '{record['vm']}' is already gone; marked deleted")
        return
    if not args.yes:
        answer = input(f"delete VM '{record['vm']}' ({record.get('ssh_dest', '?')})? [y/N] ")
        if answer.strip().lower() not in {"y", "yes"}:
            print("aborted")
            return
    sh(["ssh", "exe.dev", "rm", record["vm"]])
    record["status"] = "deleted"
    record["deleted_at"] = utc_now()
    save_run(record)
    print(f"{args.name}: deleted VM '{record['vm']}'")


def main():
    parser = argparse.ArgumentParser(prog="agent-run", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("validate", help="validate a template against the schema")
    p.add_argument("template")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("compile", help="compile a template into a provider call (prints it; never executes)")
    p.add_argument("template")
    p.add_argument("--provider", choices=sorted(ADAPTERS), default="exe.dev")
    p.add_argument("--runtime", choices=sorted(RUNTIME_PACKAGES), required=True)
    p.add_argument("--name", help="VM name (default: <template>-<runtime>)")
    p.add_argument("--script-out", help="where to write the generated setup script")
    p.set_defaults(func=cmd_compile)

    p = sub.add_parser("dispatch", help="create a VM from a template and wait until it is ready")
    p.add_argument("template")
    p.add_argument("--provider", choices=sorted(ADAPTERS), default="exe.dev")
    p.add_argument("--runtime", choices=sorted(RUNTIME_PACKAGES), required=True)
    p.add_argument("--name", help="run and VM name (default: <template>-<runtime>)")
    p.add_argument("--prompt-file", help="copied to ~/work/TASK.md once the VM is ready")
    p.add_argument("--no-wait", action="store_true", help="create the VM and return immediately")
    p.add_argument("--wait-timeout", type=int, default=900, help="seconds to wait for readiness")
    p.add_argument("--poll-interval", type=int, default=15, help="seconds between readiness checks")
    p.set_defaults(func=cmd_dispatch)

    p = sub.add_parser("status", help="show dispatched runs and their VM state")
    p.add_argument("--offline", action="store_true", help="skip the provider VM listing")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("rm", help="delete a run's VM and mark the run deleted")
    p.add_argument("name")
    p.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    p.set_defaults(func=cmd_rm)

    args = parser.parse_args()
    try:
        args.func(args)
    except (TemplateError, RunError, FileNotFoundError) as e:
        print(f"agent-run: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
