#!/usr/bin/env python3
"""Compile provider-neutral sandbox templates into provider lifecycle calls.

A template (agent-run/templates/*.yaml) describes what an environment needs:
resources, repositories, allowed runtimes, env, setup steps, and readiness
checks. A provider adapter compiles it into concrete calls; this never
executes anything against a provider itself.
"""

import argparse
import json
import pathlib
import shlex
import sys

import jsonschema
import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
SCHEMA_PATH = ROOT / "templates" / "schema.json"

# Subscription-only pilot: provider API keys must never reach a sandbox.
FORBIDDEN_ENV = {"OPENAI_API_KEY", "ANTHROPIC_API_KEY"}

# exe.dev rejects setup scripts larger than 10KiB.
SETUP_SCRIPT_LIMIT = 10 * 1024

WORKDIR = '"$HOME"/work'
READY_MARKER = f"{WORKDIR}/.agent-run-ready"

RUNTIME_PACKAGES = {"codex": "codex", "claude": "claude"}


class TemplateError(Exception):
    pass


def load_template(path):
    with open(path) as f:
        template = yaml.safe_load(f)
    with open(SCHEMA_PATH) as f:
        schema = json.load(f)
    try:
        jsonschema.validate(template, schema)
    except jsonschema.ValidationError as e:
        raise TemplateError(f"{path}: {e.message} (at {'/'.join(map(str, e.absolute_path)) or '<root>'})")
    forbidden = FORBIDDEN_ENV & set(template.get("env", {}))
    if forbidden:
        raise TemplateError(
            f"{path}: env must not set provider API keys: {', '.join(sorted(forbidden))}"
        )
    return template


def repo_parts(repo_id):
    host, owner, name = repo_id.split("/")
    return host, owner, name


def clone_url(repo, exe_cfg):
    host, owner, name = repo_parts(repo["id"])
    integrations = exe_cfg.get("integrations", [])
    if host == "github.com" and any("github" in i for i in integrations):
        return f"https://github.int.exe.xyz/{owner}/{name}.git"
    return f"https://{host}/{owner}/{name}.git"


def render_setup_script(template, runtime, exe_cfg):
    lines = [
        "#!/usr/bin/env bash",
        f"# generated by agent-run from template '{template['name']}' (runtime: {runtime})",
        "set -euxo pipefail",
        f"WORK={WORKDIR}",
        'mkdir -p "$WORK"',
        "",
    ]

    for repo in template["repos"]:
        _, _, name = repo_parts(repo["id"])
        path = repo.get("path", name)
        branch = f" --branch {shlex.quote(repo['ref'])}" if repo.get("ref") else ""
        lines.append(f'git clone{branch} {clone_url(repo, exe_cfg)} "$WORK"/{shlex.quote(path)}')
    lines.append("")

    for step in template.get("setup", []):
        if step == "update-runtimes":
            lines.append(f"sudo exeuntu update {RUNTIME_PACKAGES[runtime]}")
        elif step == "install-happy":
            lines.append("sudo npm install -g happy")
        else:
            if step.get("cwd"):
                lines.append(f'( cd "$WORK"/{shlex.quote(step["cwd"])} && {step["run"]} )')
            else:
                lines.append(step["run"])
    lines.append("")

    for check in template.get("checks", []):
        lines.append(check)

    lines += ["", f"date -u +%FT%TZ > {READY_MARKER}", ""]
    return "\n".join(lines)


def compile_exe_dev(template, runtime, name, script_path):
    if runtime not in template["runtimes"]:
        raise TemplateError(
            f"runtime '{runtime}' is not allowed by template '{template['name']}' "
            f"(allowed: {', '.join(template['runtimes'])})"
        )
    exe_cfg = template.get("providers", {}).get("exe.dev", {})

    script = render_setup_script(template, runtime, exe_cfg)
    size = len(script.encode())
    if size > SETUP_SCRIPT_LIMIT:
        raise TemplateError(
            f"setup script is {size} bytes; exe.dev limits --setup-script to {SETUP_SCRIPT_LIMIT}"
        )

    args = ["ssh", "exe.dev", "new", "--json", f"--name={name}"]
    resources = template.get("resources", {})
    if "cpu" in resources:
        args.append(f"--cpu={resources['cpu']}")
    if "memory" in resources:
        args.append(f"--memory={resources['memory']}")
    if "disk" in resources:
        args.append(f"--disk={resources['disk']}")
    if exe_cfg.get("image"):
        args.append(f"--image={exe_cfg['image']}")
    for key, value in template.get("env", {}).items():
        args += ["--env", f"{key}={value}"]
    for integration in exe_cfg.get("integrations", []):
        args.append(f"--integration={integration}")
    for tag in exe_cfg.get("tags", []) + [f"runtime-{runtime}"]:
        args.append(f"--tag={tag}")
    args.append("--setup-script=/dev/stdin")

    command = " ".join(shlex.quote(a) for a in args) + f" < {shlex.quote(str(script_path))}"
    return command, script


ADAPTERS = {"exe.dev": compile_exe_dev}


def cmd_validate(args):
    load_template(args.template)
    print(f"{args.template}: valid")


def cmd_compile(args):
    template = load_template(args.template)
    adapter = ADAPTERS[args.provider]
    name = args.name or f"{template['name']}-{args.runtime}"
    script_path = pathlib.Path(args.script_out or f"{name}-setup.sh")
    command, script = adapter(template, args.runtime, name, script_path)
    script_path.write_text(script)
    print(f"setup script -> {script_path} ({len(script.encode())} bytes)", file=sys.stderr)
    print(command)


def main():
    parser = argparse.ArgumentParser(prog="agent-run", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("validate", help="validate a template against the schema")
    p.add_argument("template")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("compile", help="compile a template into a provider call (prints it; never executes)")
    p.add_argument("template")
    p.add_argument("--provider", choices=sorted(ADAPTERS), default="exe.dev")
    p.add_argument("--runtime", choices=sorted(RUNTIME_PACKAGES), required=True)
    p.add_argument("--name", help="VM name (default: <template>-<runtime>)")
    p.add_argument("--script-out", help="where to write the generated setup script")
    p.set_defaults(func=cmd_compile)

    args = parser.parse_args()
    try:
        args.func(args)
    except (TemplateError, FileNotFoundError) as e:
        print(f"agent-run: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
