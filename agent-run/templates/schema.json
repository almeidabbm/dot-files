{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-run-template.schema.json",
  "title": "agent-run sandbox template",
  "description": "Provider-neutral description of a remote agent sandbox environment. Provider-specific settings are confined to the per-provider overrides block.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "repos",
    "runtimes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "description": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(GB|G|MB|M)?$"
        },
        "disk": {
          "type": "string",
          "pattern": "^[0-9]+(GB|G)?$"
        }
      }
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "description": "host/owner/repo, e.g. github.com/lightdash/lightdash",
            "type": "string",
            "pattern": "^[a-z0-9.-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "ref": {
            "type": "string"
          },
          "path": {
            "description": "Checkout directory relative to the sandbox workdir; defaults to the repo name.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "role": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "private": {
            "description": "Clone through the exe.dev GitHub integration gateway instead of the public URL.",
            "type": "boolean"
          }
        }
      }
    },
    "runtimes": {
      "description": "Coding-agent runtimes this template supports; the actual one is chosen at dispatch time.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude"
        ]
      }
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "setup": {
      "description": "Ordered steps run on first boot after repos are cloned. Strings are named steps the adapter knows how to render; objects are raw shell commands.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "enum": [
              "configure-llm-integration",
              "update-runtimes"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run"
            ],
            "properties": {
              "run": {
                "type": "string"
              },
              "cwd": {
                "description": "Directory relative to the sandbox workdir.",
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "checks": {
      "description": "Readiness gates; each command must exit 0 before the readiness marker is written.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exe.dev": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            },
            "integrations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            }
          }
        }
      }
    }
  }
}
